# Modo de operação: solo | collab
APP_MODE=solo

# LLM Provider: openai | ollama | openrouter
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=nemotron-mini

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o

# Whisper transcriber: api | local
WHISPER_TRANSCRIBER=api
WHISPER_LANGUAGE=pt

# Whisper Local (openai-whisper legado)
WHISPER_LOCAL_MODEL=medium
WHISPER_DEVICE=cpu

# faster-whisper (substitui openai-whisper quando WHISPER_TRANSCRIBER=local)
FASTER_WHISPER_MODEL=large-v3
FASTER_WHISPER_DEVICE=auto
FASTER_WHISPER_COMPUTE_TYPE=int8

# Storage
STORAGE_PATH=data/meetings
AUDIO_STORAGE_PATH=data/audio
MAX_AUDIO_SIZE_MB=25

# Bot
RECORDER_PROVIDER=playwright
BOT_CHROME_PROFILE=./bot_chrome_profile
BOT_NAME=Meet Agent
BOT_HEADLESS=false

# Collab (banco + fila)
MONGO_URI=mongodb://localhost:27017/meetagent
MONGO_DB=meetagent
REDIS_URL=redis://localhost:6379/0

# Diarização (opcional, requer torch + pyannote)
USE_REAL_DIARIZATION=false
HUGGINGFACE_TOKEN=
