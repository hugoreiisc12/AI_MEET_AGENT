# ── Modo ───────────────────────────────────────────────────────────────
APP_MODE=solo
# solo  = fluxo local, sem fila
# collab = fluxo com API/Fila (FastAPI + Celery/Redis)

# ── Whisper Local ──────────────────────────────────────────────────────
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=pt

# ── LLM Local (Ollama) ────────────────────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=nemotron-mini

# ── Storage ────────────────────────────────────────────────────────────
STORAGE_PATH=data/meetings
AUDIO_STORAGE_PATH=data/audio
MAX_AUDIO_SIZE_MB=25

# ── MongoDB (opcional — substitui JSON/SQLite) ────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=meetagent

# Apenas para APP_MODE=collab
DATABASE_URL=sqlite:///./data/collab.db
REDIS_URL=redis://localhost:6379/0
