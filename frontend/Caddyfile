# Servidor da interface (container `web`). API_UPSTREAM aponta para a FastAPI; no compose é api:8000.
{
	admin off
	auto_https off
}

:80 {
	encode gzip zstd

	# /api/estudio → /estudio na FastAPI. Uploads grandes e downloads passam em streaming.
	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	# Arquivos com hash no nome podem ficar em cache; o resto (index.html, ícones) é sempre conferido.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@fresh not path /assets/*
	header @fresh Cache-Control "no-cache"

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
